DATABASE_URL=mongodb://127.0.0.1:27017/bbhockey
PAYLOAD_SECRET=change-me-long-random
# public site URL, used to refresh its cache after edits (on Vercel: injected by the service binding)
WEB_URL=http://localhost:3000
# public site URL for the browser (page editor iframe); leave unset on Vercel, where both apps share one domain
WEB_PUBLIC_URL=http://localhost:3000
# same value in apps/web; protects form submissions and cache refresh
SHARED_SECRET=change-me-long-random
# Vercel Blob token for image uploads in production (leave empty locally)
BLOB_READ_WRITE_TOKEN=
# confirmation e-mails via Resend (SMTP); SMTP_PASS is the Resend API key (re_...)
# leave SMTP_HOST empty to only log e-mails instead of sending them
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# sender address on a domain verified in Resend, e.g. jelentkezes@yourdomain.hu
EMAIL_FROM=
