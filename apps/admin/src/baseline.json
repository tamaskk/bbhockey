    "gyik": {
      "show": true,
      "title": "Gyakori",
      "highlight": "kérdések",
      "items": [
        {
          "q": "Hány éves kortól lehet jelentkezni?",
          "a": "U8-tól U18-ig várunk játékosokat. A csoportokat korosztály és tudásszint szerint alakítjuk ki.",
          "id": "6b00322e30b39ef71a6d53de"
        },
        {
          "q": "Mit kell hozni a táborba?",
          "a": "Teljes jégkorong felszerelést, edzőruhát az off-ice blokkokhoz, kulacsot és váltóruhát. A tábori pólót és zoknit mi adjuk.",
          "id": "6b00322e30b39ef71a6d53df"
        },
        {
          "q": "Mennyibe kerül a tábor?",
          "a": "Egyéni jelentkezés 160 000 Ft / fő, testvéreknek 140 000 Ft / fő. Az ár tartalmazza az edzéseket, az étkezést és a tábori felszerelést.",
          "id": "6b00322e30b39ef71a6d53e0"
        },
        {
          "q": "Hogyan fizethetek?",
          "a": "A jelentkezés után e-mailben küldjük a díjbekérőt, átutalással lehet fizetni.",
          "id": "6b00322e30b39ef71a6d53e1"
        },
        {
          "q": "Kapusoknak is van program?",
          "a": "Igen, a kapusok külön kapusedzővel dolgoznak a jeges edzések egy részében.",
          "id": "6b00322e30b39ef71a6d53e2"
        },
        {
          "q": "Mi történik, ha lemondjuk a részvételt?",
          "a": "A tábor kezdete előtt 30 nappal díjmentesen lemondható, utána a részvételi feltételek szerint térítünk vissza.",
          "id": "6b00322e30b39ef71a6d53e3"
        }
      ]
    },
