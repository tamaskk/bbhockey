{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "web", "format": "url", "env": "WEB_URL" }]
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "admin", "format": "url", "env": "ADMIN_URL" }]
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
